<mujoco model="point2d">

  <compiler angle="radian" inertiafromgeom="true" autolimits="true"/>
  <option timestep="0.01" integrator="Euler" gravity="0 0 0">
    <flag contact="enable"/>
  </option>

  <asset>
    <texture name="groundplane_tex" type="2d" builtin="checker"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             width="300" height="300" mark="edge" markrgb="0.8 0.8 0.8"/>
    <material name="groundplane" texture="groundplane_tex"
              texuniform="true" texrepeat="10 10" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.01" material="groundplane"/>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>

    <!-- Planar point mass: two slide joints in x,y; z fixed by the body pos -->
    <body name="point" pos="0 0 0.05">
      <joint name="jx" type="slide" axis="1 0 0" damping="0.0" range="-2 2"/>
      <joint name="jy" type="slide" axis="0 1 0" damping="0.0" range="-2 2"/>
      <geom name="ball" type="sphere" size="0.05" rgba="0.8 0.8 0.8 1"/>
      <site name="point_site" pos="0 0 0" size="0.01"/>
    </body>

    <!-- <geom name="obs1" type="box" pos="0.0 0.5 0.0" size="0.1 0.1 0.05" contype="1" conaffinity="1"/>
    <geom name="obs2" type="box" pos="0.0 -0.5 0.0" size="0.1 0.1 0.05" contype="1" conaffinity="1"/> -->


    <!-- Goal marker (purely visual) -->
    <site name="goal_site" pos="1.0 1.0 0.05" size="0.02" rgba="1 0 0 1"/>
  </worldbody>

  <actuator>
    <!-- Motors apply generalized force on slide joints -->
    <motor name="ax" joint="jx" ctrlrange="-2 2" ctrllimited="true" gear="1"/>
    <motor name="ay" joint="jy" ctrlrange="-2 2" ctrllimited="true" gear="1"/>
  </actuator>

</mujoco>
